{
  "name": "youtab-agent-runtime",
  "version": "1.0.0",
  "description": "Portable Youtab execution runtime for agents and Super-Agent Units under One Brain.",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "ui-tui",
    "ui-tui/packages/*",
    "web",
    "tests-js"
  ],
  "scripts": {
    "postinstall": "echo '✅ Browser tools ready. Run: python run_agent.py --help'",
    "install:root": "npm install --workspaces=false",
    "install:web": "npm install --workspace web",
    "install:tui": "npm install --workspace ui-tui",
    "install:desktop": "npm install --workspace apps/desktop",
    "audit:root": "npm audit --workspaces=false",
    "audit:web": "npm audit --workspace web",
    "audit:tui": "npm audit --workspace ui-tui",
    "audit:fix:root": "npm audit fix --workspaces=false",
    "audit:fix:web": "npm audit fix --workspace web",
    "audit:fix:tui": "npm audit fix --workspace ui-tui",
    "check": "npm run --workspaces --if-present check",
    "fix": "npm run --workspaces --if-present fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Youtab-AI-OS/agent-offline-online.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/Youtab-AI-OS/agent-offline-online/issues"
  },
  "homepage": "https://github.com/Youtab-AI-OS/agent-offline-online#readme",
  "dependencies": {
    "agent-browser": "^0.26.0",
    "katex": "0.18.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^9.39.4",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "6.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0"
  },
  "overrides": {
    "lodash": "4.18.1",
    "yauzl": "^3.3.1",
    "protobufjs": "^8.7.1",
    "dompurify": "3.4.16",
    "sanitize-html": "2.17.7",
    "@tailwindcss/typography@0.5.20": {
      "postcss-selector-parser": "6.1.5"
    },
    "micromark-extension-math@3.1.0": {
      "katex": "0.18.10"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
